# CIL Bros Construction - Supabase connection.
#
# To use this: copy it to .env.local and restart the dev server.
#
#   cp .env.example .env.local
#   npm run dev
#
# Both values below are public by design. They identify the project and nothing
# more - they are compiled into the browser bundle, so anyone visiting the site
# can already read them. What you are allowed to do with them is decided by the
# row-level security policies in supabase/schema.sql.
#
# The service_role / sb_secret_... key is NOT one of these. It bypasses every
# policy. Never put it in this file, in .env.local, or in Cloudflare. Nothing in
# this project needs it.

# Project Settings -> Data API -> Project URL
VITE_SUPABASE_URL=https://benaxdcxrxeyxctcjrer.supabase.co

# Project Settings -> API keys -> publishable key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=sb_publishable_T_FDnkhK7-PS_LstURXK5Q_qsECGxo0

# The domain admin usernames are turned into email addresses with, so "Igor"
# signs in as igor@cilbrosconstruction.com. Only uncomment this to change it -
# it must match the address of the login you created for Dragomir.
# VITE_ADMIN_EMAIL_DOMAIN=cilbrosconstruction.com
